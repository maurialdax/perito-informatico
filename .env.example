# Puerto del servidor
PORT=3000

# Motor de base de datos: sqlite (desarrollo) o postgres (producción)
DB_DIALECT=sqlite

# --- SQLite ---
DB_STORAGE=forensics.db

# --- PostgreSQL (usar con DB_DIALECT=postgres) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=forensics
DB_USER=forensics_user
DB_PASSWORD=forensics_pass
